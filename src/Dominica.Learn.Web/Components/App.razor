@inject Dominica.Learn.Web.Seguranca.OpcoesDeHospedagem Hospedagem
﻿<!DOCTYPE html>
@* pt-BR e não "en": é o `lang` que diz ao leitor de tela com que fonética ler o texto. Com "en"
   um leitor de tela lê "Licitações" com pronúncia inglesa, e o corretor do navegador sublinha o
   português inteiro. Veio "en" do template. *@
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* O <base> é o que faz TODO link relativo do app cair dentro do caminho onde ele está servido.
       Por isso nenhum href do Learn começa com barra: barra inicial ignora o <base> e sai do
       sub-caminho. Ver OpcoesDeHospedagem. *@
    <base href="@Hospedagem.BaseHref" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    @* O MudBlazor não funciona só com AddMudServices(): sem esta folha e o script lá embaixo, os
       componentes renderizam sem estilo e o que depende de JS — Snackbar, Tooltip, Dialog, Menu —
       simplesmente não aparece, sem erro nenhum no console. *@
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Dominica.Learn.Web.styles.css"]" />
    <ImportMap />
    @* O arco da marca na aba. SVG primeiro: escala em qualquer densidade de tela e é um arquivo só.
       O PNG fica de reserva para navegador que ignore o type — a ordem é a que decide. *@
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" type="image/png" href="favicon.png" />

    @* Reaplica o tema ANTES da primeira pintura. Sem isto, quem escolheu escuro vê a página nascer
       creme e piscar para escuro quando o circuito conecta — no escuro de um quarto, é um flash na
       cara. É `<script>` inline no <head> de propósito: qualquer arquivo externo chegaria tarde
       demais. Quem GRAVA a escolha é js/tema.js; isto aqui só a repõe. *@
    <script>
        (function () {
            try {
                var t = localStorage.getItem('dominica-learn-tema');
                if (t) document.documentElement.setAttribute('data-tema', t);
            } catch (e) { /* modo privado: cai no tema do sistema, que é o certo */ }
        })();
    </script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>

</html>
