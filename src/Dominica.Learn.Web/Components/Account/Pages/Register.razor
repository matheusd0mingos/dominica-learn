@page "/Account/Register"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("autenticacao")]

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Dominica.Learn.Web.Data
@using Dominica.Learn.Domain.Vault
@using Dominica.Learn.Web.Seguranca
@using Microsoft.Extensions.Options
@using Microsoft.EntityFrameworkCore
@using Npgsql

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject IOptions<OpcoesDeAdministracao> Administracao
@inject AuthenticationStateProvider Autenticacao

<PageTitle>Criar conta — Dominica Learn</PageTitle>

@* if/else, e não um `return` no meio da marcação: o Razor exige que as tags fechem DENTRO do mesmo
   bloco, então sair cedo obrigaria a fechar o cartão duas vezes — e a segunda é a que se esquece. *@
<div class="identidade-cartao">
    <h1>Criar conta</h1>

    @if (!_podeCadastrar)
    {
        @* Cadastro fechado é o PADRÃO, e o motivo está em OpcoesDeAdministracao: aberto, qualquer um que
           descubra a URL cria conta e ocupa disco. A mensagem não diz "acesso negado" nem insinua que
           existe um jeito de contornar — diz o que é verdade e quem resolve. *@
        <div class="alert alert-secondary" role="alert">
            O cadastro está fechado. Peça uma conta a quem administra o Dominica Learn.
        </div>
    }
    else
    {
        @if (_criandoComoAdmin)
        {
            <div class="alert alert-info" role="alert">
                Você está criando uma conta <b>para outra pessoa</b>, como administrador. Passe a senha a ela;
                o apelido escolhido aqui vira a pasta do vault dela e não muda depois.
            </div>
        }
        <StatusMessage Message="@Message" />
        <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Apelido" id="Input.Apelido" class="form-control" autocomplete="nickname" aria-required="true" placeholder="matheus" />
                <label for="Input.Apelido">Apelido</label>
                <ValidationMessage For="() => Input.Apelido" class="text-danger" />
                <small class="form-text text-muted">
                    Vira o nome da pasta do seu vault no disco e não pode ser alterado depois.
                    Letras sem acento, números e hífen.
                </small>
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="voce@exemplo.com" />
                <label for="Input.Email">E-mail</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="uma frase que só você sabe" />
                <label for="Input.Password">Frase secreta</label>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="a mesma frase" />
                <label for="Input.ConfirmPassword">Repita a frase secreta</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Criar conta</button>
        </EditForm>
    }
</div>

@code {
    private IEnumerable<IdentityError>? identityErrors;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? Message => identityErrors is null ? null : $"Erro: {string.Join(", ", identityErrors.Select(error => error.Description))}";

    private bool _podeCadastrar;
    private bool _criandoComoAdmin;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        // O admin mestre passa mesmo com o cadastro fechado: é assim que ele cria a conta dos outros,
        // sem precisar de convite por token nem de abrir a porta para o mundo por alguns minutos.
        var estado = await Autenticacao.GetAuthenticationStateAsync();
        _criandoComoAdmin = Administracao.Value.EhAdminMestre(estado.User);
        _podeCadastrar = Administracao.Value.CadastroAberto || _criandoComoAdmin;
    }

    public async Task RegisterUser(EditContext editContext)
    {
        // Esconder o formulário não é proteger: o POST pode ser montado à mão. A checagem que vale é esta.
        if (!_podeCadastrar)
        {
            identityErrors = [new IdentityError { Code = "Fechado", Description = "O cadastro está fechado." }];
            return;
        }

        // O APELIDO É VALIDADO PELO DOMÍNIO, não por DataAnnotation. Quem sabe o que é um nome de pasta
        // seguro é o ApelidoDoUsuario, e duplicar essa regra numa anotação aqui seria a primeira das duas
        // cópias que um dia divergem — com a divergência aparecendo como uma pasta que não pode ser criada.
        if (!ApelidoDoUsuario.TentarCriar(Input.Apelido, out var apelido, out var erroDoApelido) || apelido is null)
        {
            identityErrors = [new IdentityError { Code = "Apelido", Description = erroDoApelido! }];
            return;
        }

        // Unicidade: o apelido é uma PASTA. Dois usuários com o mesmo apelido dividiriam o mesmo vault —
        // exatamente o defeito que este cadastro existe para não ter.
        //
        // ESTA CONSULTA É PELA MENSAGEM, NÃO PELA GARANTIA. Entre perguntar e criar cabe outro cadastro,
        // e quem garante de verdade é o índice único no banco (ver ApplicationDbContext). Ela fica porque
        // "esse apelido já está em uso" dito ANTES de a pessoa preencher senha e confirmação é outra
        // experiência — a garantia do banco é a rede embaixo, e a rede aparece no catch lá adiante.
        if (await UserManager.Users.AnyAsync(u => u.Apelido == apelido.Valor))
        {
            identityErrors = [new IdentityError { Code = "Apelido", Description = $"O apelido \"{apelido.Valor}\" já está em uso." }];
            return;
        }

        var user = CreateUser();
        user.Apelido = apelido.Valor;

        await UserStore.SetUserNameAsync(user, Input.Email, CancellationToken.None);
        var emailStore = GetEmailStore();
        await emailStore.SetEmailAsync(user, Input.Email, CancellationToken.None);
        // A REDE EMBAIXO DA CONSULTA ACIMA: se outro cadastro tomou o apelido no meio do caminho, quem
        // recusa é o índice único, e ele recusa com uma exceção do Npgsql — que sem isto viraria uma
        // página de erro genérica no fim de um formulário preenchido. O texto é o MESMO da checagem
        // antecipada, porque para quem está cadastrando é o mesmo fato.
        IdentityResult result;
        try
        {
            result = await UserManager.CreateAsync(user, Input.Password);
        }
        catch (DbUpdateException e) when (e.InnerException is PostgresException { SqlState: "23505" })
        {
            identityErrors = [new IdentityError { Code = "Apelido", Description = $"O apelido \"{apelido.Valor}\" acabou de ser registrado por outra pessoa. Escolha outro." }];
            return;
        }

        if (!result.Succeeded)
        {
            identityErrors = result.Errors;
            return;
        }

        Logger.LogInformation("User created a new account with password.");

        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code, ["returnUrl"] = ReturnUrl });

        await EmailSender.SendConfirmationLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));

        if (UserManager.Options.SignIn.RequireConfirmedAccount)
        {
            RedirectManager.RedirectTo(
                "Account/RegisterConfirmation",
                new() { ["email"] = Input.Email, ["returnUrl"] = ReturnUrl });
        }
        else if (_criandoComoAdmin)
        {
            // NÃO autentica: o admin acabou de criar a conta de OUTRA pessoa e continuaria logado como
            // ela — trocando de vault sem perceber, no meio da própria sessão.
            RedirectManager.RedirectTo("/administracao", new() { ["criado"] = apelido.Valor });
        }
        else
        {
            await SignInManager.SignInAsync(user, isPersistent: false);
            RedirectManager.RedirectTo(ReturnUrl);
        }
    }

    private ApplicationUser CreateUser()
    {
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }
        catch
        {
            throw new InvalidOperationException($"Can't create an instance of '{nameof(ApplicationUser)}'. " +
                $"Ensure that '{nameof(ApplicationUser)}' is not an abstract class and has a parameterless constructor.");
        }
    }

    private IUserEmailStore<ApplicationUser> GetEmailStore()
    {
        if (!UserManager.SupportsUserEmail)
        {
            throw new NotSupportedException("The default UI requires a user store with email support.");
        }
        return (IUserEmailStore<ApplicationUser>)UserStore;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Escolha um apelido.")]
        [Display(Name = "Apelido")]
        public string Apelido { get; set; } = "";

        [Required(ErrorMessage = "Diga o seu e-mail.")]
        [EmailAddress(ErrorMessage = "Isso não parece um e-mail.")]
        [Display(Name = "E-mail")]
        public string Email { get; set; } = "";

        // DOZE, e não os seis do template. O Identity deste app exige doze (ver Program.cs). Com seis
        // aqui, o formulário aceitava, mandava para o servidor, e a recusa voltava em inglês — no
        // primeiro minuto de uso do produto. Validação de formulário que discorda do servidor é pior
        // que validação nenhuma. Mesmo motivo e mesmo texto em ResetPassword.
        [Required(ErrorMessage = "Escreva a sua frase secreta.")]
        [StringLength(128, MinimumLength = 12,
            ErrorMessage = "A frase precisa de pelo menos 12 caracteres — uma frase inteira, não uma palavra.")]
        [DataType(DataType.Password)]
        [Display(Name = "Frase secreta")]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Repita a frase secreta")]
        [Compare("Password", ErrorMessage = "As duas frases não são iguais.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
