@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Options
@using Dominica.Learn.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject IOptions<IdentityOptions> OpcoesDoIdentity
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Esqueci minha frase secreta — Dominica Learn</PageTitle>

@* Esta tela estava em inglês e sem caminho até ela: o Login não a oferecia, porque o app não mandava
   e-mail. Com o envio configurado ela passou a ser alcançável, e aí traduzir deixou de ser cosmético.

   NÃO EXISTE MENSAGEM DE "ESSE E-MAIL NÃO ESTÁ CADASTRADO", e a ausência é de segurança: a resposta é
   a mesma existindo ou não a conta. Um formulário que diferencia os dois casos vira uma lista de quem
   tem conta aqui para quem quiser testar endereços. *@

<div class="identidade-cartao">
    <h1>Esqueci minha frase secreta</h1>
    <p class="text-secondary small">
        Diga o e-mail da sua conta e mandamos um link para você criar uma nova.
    </p>

    <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />

        <div class="form-floating mb-3">
            <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control"
                       autocomplete="username" aria-required="true" placeholder="voce@exemplo.com" />
            <label for="Input.Email" class="form-label">E-mail</label>
            <ValidationMessage For="() => Input.Email" class="text-danger" />
        </div>

        <button type="submit" class="w-100 btn btn-lg btn-primary">Mandar o link</button>
    </EditForm>

    <p class="text-secondary small mt-3 mb-0">
        <a href="Account/Login">Voltar para a entrada</a>
    </p>
</div>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);

        // A EXIGÊNCIA DE E-MAIL CONFIRMADO SEGUE A DO LOGIN, e não é fixa — foi isso que o template
        // fazia, e teria trancado todo mundo do lado de fora.
        //
        // Aqui as contas nascem pela tela de administração e ninguém confirma e-mail nenhum, porque
        // entrar não exige confirmação (SignIn.RequireConfirmedAccount = false, ver Program.cs). Com a
        // regra fixa do template, TODO pedido de recuperação cairia em silêncio: a tela diria "o link
        // acabou de sair" e nada sairia, para todos os usuários, para sempre. O sintoma seria idêntico
        // ao de um servidor de e-mail mal configurado, e a busca iria para o lado errado.
        //
        // Amarrando as duas exigências à mesma chave, o app fica coerente: se entrar não pede
        // confirmação, recuperar também não pede; se um dia passar a pedir, as duas passam juntas.
        var precisaConfirmar = OpcoesDoIdentity.Value.SignIn.RequireConfirmedAccount;
        if (user is null || (precisaConfirmar && !await UserManager.IsEmailConfirmedAsync(user)))
        {
            // Mesma resposta do caminho de sucesso — ver o comentário no topo.
            RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
            return;
        }

        var code = await UserManager.GeneratePasswordResetTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
            new Dictionary<string, object?> { ["code"] = code });

        await EmailSender.SendPasswordResetLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));

        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Diga o e-mail da conta.")]
        [EmailAddress(ErrorMessage = "Isso não parece um e-mail.")]
        public string Email { get; set; } = "";
    }
}
