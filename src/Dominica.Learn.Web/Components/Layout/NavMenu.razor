@implements IDisposable

@inject NavigationManager NavigationManager

@* A navegação, inline na barra do topo. Sem os ícones bitmap do template: eram SVGs embutidos em
   base64 com `fill='white'` cravado, o que já os deixava invisíveis em qualquer fundo claro. Cinco
   itens com nome escrito não precisam de ícone. *@

<nav class="nav-app">
    @* As três telas do vault são [Authorize]. Mostrá-las a quem não entrou seria oferecer três
       botões que só fazem voltar para o login — e a tela de login já é a que a pessoa está vendo. *@
    <AuthorizeView>
        <Authorized>
            <NavLink class="nav-item" href="notas">Notas</NavLink>
            <NavLink class="nav-item" href="revisar">Revisar</NavLink>
            <NavLink class="nav-item" href="grafo">Grafo</NavLink>
            <NavLink class="nav-item" href="etiquetas">Etiquetas</NavLink>
            <NavLink class="nav-item" href="backup">Backup</NavLink>
        </Authorized>
    </AuthorizeView>

    @* Só aparece para o admin mestre. A rota é protegida por política — isto aqui é conveniência,
       não segurança: esconder o link nunca protegeu nada. *@
    <AuthorizeView Policy="@Dominica.Learn.Web.Seguranca.OpcoesDeAdministracao.Politica">
        <Authorized>
            <NavLink class="nav-item" href="administracao">Administração</NavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView>
        <Authorized>
            <span class="nav-sep" aria-hidden="true"></span>
            <NavLink class="nav-item nav-quem" href="Account/Manage">@context.User.Identity?.Name</NavLink>
            <form action="Account/Logout" method="post" class="nav-sair">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                <button type="submit" class="nav-item nav-botao">Sair</button>
            </form>
        </Authorized>
        <NotAuthorized>
            <span class="nav-sep" aria-hidden="true"></span>
            <NavLink class="nav-item" href="Account/Login">Entrar</NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
