@page "/revisar"
@page "/revisar/{*nome}"
@using Dominica.Learn.Application.CasosDeUso
@using Dominica.Learn.Domain.Cartoes
@using Dominica.Learn.Domain.Vault
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@using Dominica.Learn.Application.Portas
@inject ServicoDeCartoes Cartoes
@inject IPreferenciasDoUsuario Preferencias
@inject NavigationManager Navegacao
@inject ISnackbar Avisos
@inject IDialogService Dialogos

<PageTitle>Revisar · Dominica Learn</PageTitle>

<ProvedoresDoMud />

<MudPaper Class="pa-4" Elevation="0" Outlined="true">
    <div class="d-flex align-center flex-wrap gap-3 mb-4">
        <MudText Typo="Typo.h6">
            @(_materia is null ? "Revisar" : $"Revisar — {_materia.Rotulo}")
        </MudText>
        @if (_materia is not null)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" Href="revisar">Todas as matérias</MudButton>
        }

        @* ESCOLHER A MATÉRIA TEM DE SER POSSÍVEL COM A FILA CHEIA. A lista lá embaixo só aparece quando
           a fila acaba — ou seja, quando não há mais nada a decidir. Quem abre a tela com 37 cartões
           vencidos e quer estudar só Contabilidade hoje precisa disto AQUI, antes do primeiro cartão.
           Continua sem clique a mais para quem só quer começar: a fila arranca sozinha. *@
        @if (_porMateria.Count(m => m.Vencidos > 0) > 1)
        {
            <MudMenu Label="Escolher matéria" Size="Size.Small" Variant="Variant.Text"
                     EndIcon="@Icons.Material.Filled.ArrowDropDown" Dense="true">
                @foreach (var m in _porMateria.Where(m => m.Vencidos > 0))
                {
                    <MudMenuItem Href="@($"revisar/{Uri.EscapeDataString(m.Materia.Nome)}")">
                        @m.Materia.Rotulo — @m.Vencidos vencido(s)
                    </MudMenuItem>
                }
            </MudMenu>
        }

        @* O TETO DIÁRIO fica aqui, ao lado da fila, e não escondido numa tela de configurações: é o
           parâmetro que decide se a rotina sobrevive, e ele precisa ser ajustável no dia em que a
           sessão ficou pesada demais — que é justamente quando a pessoa está nesta tela. *@
        <MudMenu Label="@($"Novos por dia: {(_teto == 0 ? "sem teto" : _teto.ToString())}")"
                 Size="Size.Small" Variant="Variant.Text"
                 EndIcon="@Icons.Material.Filled.ArrowDropDown" Dense="true">
            @foreach (var opcao in new[] { 5, 10, 20, 30, 50, 0 })
            {
                <MudMenuItem OnClick="@(() => DefinirTetoAsync(opcao))">
                    @(opcao == 0 ? "Sem teto" : $"{opcao} por dia")
                </MudMenuItem>
            }
        </MudMenu>

        @* SUSPENDER, ao lado das notas e não escondido: a hora de tirar um cartão mal formulado da
           frente é exatamente quando ele aparece. Sem esta saída, a pessoa responde "bom" num cartão que
           não presta só para ele sumir — e aí a fila vira um lugar onde se mente para o algoritmo. *@
        @if (_atual is not null)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.PauseCircleOutline"
                       OnClick="SuspenderAtualAsync">Suspender</MudButton>
        }

        @* CARTÃO NOVO, AQUI DENTRO.

           Criar cartão só existia dentro do editor, atrás de um ícone — e é revisando que se percebe o
           que falta ("isto aqui devia ter um cartão"). Obrigar a sair, achar a nota certa e procurar o
           botão é obrigar a abandonar a sessão, e o cartão que se abandona é o cartão que não existe.

           "Errei uma questão", ao lado, parece a mesma coisa e NÃO É: aquele carrega uma intenção — o
           cartão nasceu de uma questão errada, vai para a nota de erros da matéria e leva a etiqueta que
           responde "onde eu mais erro". Este não tem intenção nenhuma. Fundir os dois faria todo cartão
           criado às pressas virar registro de erro. *@
        <MudButton Size="Size.Small" Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.AddCard"
                   OnClick="NovoCartaoAsync">Cartão novo</MudButton>

        @* "Errei uma questão" fica AQUI porque é aqui que se está quando o erro dói. Também está no menu
           da tela de notas — o gesto precisa ser alcançável de onde a pessoa estiver, e não exigir que
           ela ache a nota certa antes. *@
        <MudButton Size="Size.Small" Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ReportProblem"
                   OnClick="RegistrarErroAsync">Errei uma questão</MudButton>

        @* DESFAZER — responder era a única ação irreversível deste ciclo, e é feita com o polegar, em
           sequência. Aparece SÓ depois de responder, e diz QUAL cartão vai voltar: "desfazer" sozinho,
           depois de trinta cartões, é um botão que ninguém tem coragem de apertar. *@
        @if (_desfazivel is { } desfazer)
        {
            <MudTooltip Text="@($"Volta \"{CartaoProblema.Resumir(desfazer.Frente)}\" ao agendamento que tinha")">
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Undo"
                           Disabled="_gravando" OnClick="DesfazerAsync">Desfazer</MudButton>
            </MudTooltip>
        }

        <MudSpacer />
        @if (_fila.Count > 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@_fila.Count por revisar</MudText>
        }
    </div>

    @if (_carregando)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_atual is null)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4">
            @(_revisados > 0
                ? $"Acabou por hoje — {_revisados} cartão(ões) revisado(s)."
                : "Nenhum cartão vencido agora.")

            @* Dizer que sobraram inéditos é o que impede o teto de parecer um defeito. Sem esta linha,
               alguém que escreveu 37 cartões veria 20 e acharia que os outros se perderam. *@
            @if (_teto > 0 && _ineditosSegurados > 0)
            {
                <div class="mt-2">
                    <b>@_ineditosSegurados cartão(ões) inédito(s)</b> ficaram para os próximos dias — é o
                    teto de @_teto por dia segurando a dívida de revisão. Dá para mudá-lo ali em cima.
                </div>
            }
        </MudAlert>

        @* A lista por matéria é o "por onde começo hoje". Fica aqui, e não numa tela à parte, porque é
           exatamente o que se quer ver quando a fila termina ou quando ela nem começou. *@
        @if (_porMateria.Count > 0)
        {
            <MudText Typo="Typo.overline" Class="d-block">Cartões por matéria</MudText>
            <MudList T="string" Dense="true">
                @foreach (var m in _porMateria)
                {
                    <MudListItem T="string" Href="@($"revisar/{Uri.EscapeDataString(m.Materia.Nome)}")"
                                 Icon="@(m.Vencidos > 0 ? Icons.Material.Filled.Schedule : Icons.Material.Filled.Done)"
                                 IconColor="@(m.Vencidos > 0 ? Color.Warning : Color.Success)">
                        <MudText Typo="Typo.body2">
                            @m.Materia.Rotulo — <b>@m.Vencidos</b> vencido(s) de @m.Total
                        </MudText>
                    </MudListItem>
                }
            </MudList>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Nenhum cartão no vault ainda. Escreva <code>Pergunta::Resposta</code> numa nota — ou
                a pergunta, uma linha com <code>?</code>, e a resposta — e ela vira cartão.
                O formato é o do plugin de repetição espaçada do Obsidian, então os mesmos cartões
                funcionam lá.
            </MudText>
        }
    }
    else
    {
        @* POR QUE ESTA ORDEM. A fila passou a ouvir o registro de estudo — a matéria em que se perde
           desempenho vem primeiro, DENTRO de cada dia de vencimento. Uma fila que se reordena em
           silêncio é pior que uma que não se reordena: a pessoa vê uma matéria que não escolheu e conclui
           que o sistema está confuso, não que ele está ajudando. Ver OndeVocePerde. *@
        @if (_motivoDaOrdem is { Length: > 0 } motivo)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Size="Size.Small" Class="mr-1" />@motivo
            </MudText>
        }

        <MudPaper Class="pa-6 mb-4" Outlined="true" Style="min-height:36vh">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @_atual.Nota.Nome · @Materia.De(_atual.Nota).Rotulo
            </MudText>

            <MudText Typo="Typo.h5" Class="mt-3">@_atual.Frente</MudText>

            @if (_revelado)
            {
                @* O AVISO SÓ DEPOIS DE REVELAR, e a razão é a mecânica da revisão: mostrá-lo junto com a
                   pergunta contaria que este é "o cartão difícil" antes de a pessoa tentar lembrar — e o
                   esforço de recuperar da memória é o mecanismo inteiro da repetição espaçada.

                   E ele aparece AQUI, no cartão, e não numa lista noutra tela: a hora de decidir
                   reescrever um cartão ruim é a hora em que ele está na sua frente pela sétima vez. Ver
                   CartaoProblema. *@
                @if (CartaoProblema.Diagnostico(_atual) is { Length: > 0 } diagnostico)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-4">
                        @diagnostico
                        <div class="mt-2">
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.EditNote"
                                       Href="@Rotas.Nota(_atual.Nota)">Abrir a nota e reescrever</MudButton>
                        </div>
                    </MudAlert>
                }

                <MudDivider Class="my-4" />
                @* white-space:pre-wrap preserva as quebras do verso de bloco: uma resposta de três linhas
                   escrita em três linhas tem de aparecer em três linhas. *@
                <MudText Typo="Typo.body1" Style="white-space:pre-wrap">@_atual.Verso</MudText>
            }
        </MudPaper>

        @if (!_revelado)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       OnClick="@(() => _revelado = true)">Mostrar resposta</MudButton>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                Tente lembrar antes de virar — é o esforço de lembrar que fixa, não a leitura.
            </MudText>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="_gravando"
                           OnClick="@(() => ResponderAsync(Resposta.Errei))">Errei</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="_gravando"
                           OnClick="@(() => ResponderAsync(Resposta.Dificil))">Difícil</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_gravando"
                           OnClick="@(() => ResponderAsync(Resposta.Bom))">Bom</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="_gravando"
                           OnClick="@(() => ResponderAsync(Resposta.Facil))">Fácil</MudButton>
            </div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                @_previsao
            </MudText>
        }

        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-4">
            <MudLink Href="@($"notas/{_atual.Nota.Valor}")">Abrir a nota deste cartão</MudLink>
            — o agendamento é gravado no próprio arquivo, e o Obsidian lê o mesmo.
        </MudText>
    }
</MudPaper>

@code {
    /// <summary>Nome da matéria vindo da rota. Chamado "Nome", e não "Materia", porque um parâmetro
    /// com o nome do tipo o sombreia dentro do componente e "Materia.De(...)" deixa de compilar.</summary>
    [Parameter] public string? Nome { get; set; }

    private Materia? _materia;
    private IReadOnlyList<Cartao> _fila = [];
    private int _teto = TetoDeCartoesNovos.Padrao;
    private int _ineditosSegurados;

    /// <summary>Por que esta ordem, quando o registro teve algo a dizer. Ver OndeVocePerde.</summary>
    private string? _motivoDaOrdem;
    private IReadOnlyList<CartoesDaMateria> _porMateria = [];
    private Cartao? _atual;
    private bool _revelado;
    private bool _carregando = true;
    private bool _gravando;
    private int _revisados;

    /// <summary>
    /// A última resposta, e só ela.
    ///
    /// UMA SÓ, E NÃO UMA PILHA, de propósito. O erro que este recurso conserta é o clique errado que se
    /// percebe NO INSTANTE seguinte — "toquei Fácil e era Errei". Desfazer cinco respostas atrás não é
    /// esse erro: é reescrever um histórico que já foi usado para agendar outros cartões, e o resultado
    /// seria uma fila que ninguém consegue explicar. Uma só cobre o caso real e não abre essa porta.
    ///
    /// <c>Agendamento</c> nulo aqui é informação, não ausência dela: quer dizer que o cartão era inédito.
    /// </summary>
    private sealed record Desfazivel(CaminhoNota Nota, int Linha, Agendamento? Agendamento, string Frente);

    private Desfazivel? _desfazivel;

    /// <summary>O que cada botão faria, calculado com o MESMO agendador que vai gravar.</summary>
    private string _previsao = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _materia = string.IsNullOrWhiteSpace(Nome) ? null : Materia.De(Uri.UnescapeDataString(Nome));
        _revisados = 0;
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        var hoje = await Cartoes.FilaAsync(_materia);
        _fila = hoje.Cartoes;
        _teto = hoje.Teto;
        _ineditosSegurados = hoje.IneditosSegurados;
        _motivoDaOrdem = hoje.MotivoDaOrdem;
        _porMateria = await Cartoes.PorMateriaAsync();
        Avancar();
        _carregando = false;
    }

    /// <summary>
    /// Muda o teto e recarrega. Recarregar é obrigatório: o teto define QUANTOS inéditos entram, então o
    /// valor novo só significa alguma coisa depois de a fila ser remontada com ele.
    /// </summary>
    private async Task DefinirTetoAsync(int quantos)
    {
        await Preferencias.DefinirCartoesNovosPorDiaAsync(quantos);
        await CarregarAsync();
    }

    /// <summary>
    /// Tira o cartão da fila sem apagá-lo. O agendamento fica no arquivo — devolvê-lo depois devolve o
    /// histórico junto.
    /// </summary>
    private async Task SuspenderAtualAsync()
    {
        if (_atual is null) return;

        var alvo = _atual;
        var r = await Cartoes.SuspenderAsync(alvo.Nota, alvo.Linha, suspenso: true);
        if (!r.Ok)
        {
            Avisos.Add(r.Mensagem ?? "Não consegui suspender.", Severity.Warning);
            return;
        }

        // Dizer ONDE ele foi parar: um cartão que some sem explicação é indistinguível de um cartão
        // apagado, e a diferença entre as duas coisas é o ponto inteiro da suspensão.
        Avisos.Add($"Suspenso. Ele continua em \"{alvo.Nota.Nome}\", com o histórico guardado.", Severity.Info);
        await CarregarAsync();
    }

    /// <summary>
    /// Cartão novo, sem sair da revisão.
    ///
    /// O DESTINO JÁ VEM PREENCHIDO com a nota do cartão que está na tela: quem está revisando e pensa
    /// "falta um cartão sobre isto" quase sempre quer que ele viva junto do que explica o assunto. Vem
    /// preenchido, não imposto — o seletor continua ali para quando não for.
    /// </summary>
    private async Task NovoCartaoAsync()
    {
        var parametros = new DialogParameters<DialogoDeNovoCartao>
        {
            { d => d.EscolherDestino, true },
            { d => d.DestinoSugerido, _atual?.Nota },
        };

        var d = await Dialogos.ShowAsync<DialogoDeNovoCartao>("Cartão novo", parametros);
        var r = await d.Result;
        if (r is null || r.Canceled || r.Data is not CaminhoNota onde) return;

        // DIZ ONDE FOI PARAR, com link. Guardar algo e não dizer onde é a forma mais rápida de a pessoa
        // parar de confiar — mesma regra do registro de erro.
        Avisos.Add($"Cartão criado em {onde.Nome}.", Severity.Success);

        // Recarrega: o cartão novo é inédito e vence hoje, então ele ENTRA na fila desta sessão (se o
        // teto permitir). Não recarregar deixaria a tela dizendo um número e a fila entregando outro.
        await CarregarAsync();
    }

    /// <summary>
    /// Abre o registro de erro já com a matéria do cartão que está na tela — que é quase sempre a certa
    /// quando o erro nasce no meio de uma revisão.
    /// </summary>
    private async Task RegistrarErroAsync()
    {
        var sugerida = _materia?.Nome ?? (_atual is null ? null : Materia.De(_atual.Nota).Nome);
        var parametros = new DialogParameters<DialogoDeErro> { { d => d.MateriaInicial, sugerida } };

        var d = await Dialogos.ShowAsync<DialogoDeErro>("Errei uma questão", parametros);
        var r = await d.Result;
        if (r is null || r.Canceled || r.Data is not CaminhoNota onde) return;

        // Diz ONDE foi parar, com link. Guardar algo e não dizer onde é a forma mais rápida de a pessoa
        // parar de confiar no registro.
        Avisos.Add($"Guardado em {onde.Nome}.", Severity.Success);
        await CarregarAsync();
    }

    /// <summary>
    /// Devolve o último cartão respondido ao agendamento que ele tinha, e o põe de volta na frente.
    ///
    /// AS DUAS COISAS, e não só a primeira: consertar o arquivo e deixar o cartão fora da fila seria
    /// desfazer pela metade — a pessoa desfez porque quer responder de novo, agora certo. Por isso a fila
    /// é RECARREGADA do zero em vez de reinserir o cartão na lista que está na memória: só assim ele volta
    /// com o agendamento restaurado, e não com a cópia velha que a tela tinha.
    /// </summary>
    private async Task DesfazerAsync()
    {
        if (_desfazivel is not { } d || _gravando) return;

        _gravando = true;
        try
        {
            var r = await Cartoes.DesfazerRespostaAsync(d.Nota, d.Linha, d.Agendamento);
            if (!r.Ok)
            {
                Avisos.Add(r.Mensagem ?? "Não consegui desfazer.", Severity.Warning);
                return;
            }

            _desfazivel = null;
            if (_revisados > 0) _revisados--;

            await CarregarAsync();

            // Põe o cartão desfeito na frente. Ele já está na fila — a resposta foi desfeita, então ele
            // voltou a vencer —, e é dele que a pessoa quer tratar agora.
            _fila = [.. _fila.Where(c => c.Nota.Equals(d.Nota) && c.Linha == d.Linha),
                     .. _fila.Where(c => !(c.Nota.Equals(d.Nota) && c.Linha == d.Linha))];
            Avancar();

            Avisos.Add("Desfeito. O cartão voltou como estava.", Severity.Success);
        }
        finally
        {
            _gravando = false;
        }
    }

    private void Avancar()
    {
        _atual = _fila.FirstOrDefault();
        _revelado = false;
        _previsao = _atual is null ? string.Empty : Prever(_atual);
    }

    /// <summary>
    /// Mostra o que cada resposta faz ANTES de clicar, calculado pelo mesmo <see cref="AgendadorSM2"/>
    /// que vai gravar. Não é enfeite: sem isso a pessoa aperta os botões no escuro e nunca entende por
    /// que um cartão voltou no dia seguinte — e deixa de confiar no agendamento.
    /// </summary>
    private static string Prever(Cartao cartao)
    {
        var hoje = DateOnly.FromDateTime(DateTime.Today);
        var atual = cartao.AgendamentoOu(hoje);

        string Dias(Resposta r)
        {
            var d = AgendadorSM2.Proximo(atual, r, hoje).IntervaloEmDias;
            return d == 0 ? "hoje" : d == 1 ? "1 dia" : $"{d} dias";
        }

        return $"Errei: {Dias(Resposta.Errei)} · Difícil: {Dias(Resposta.Dificil)} · " +
               $"Bom: {Dias(Resposta.Bom)} · Fácil: {Dias(Resposta.Facil)}";
    }

    private async Task ResponderAsync(Resposta resposta)
    {
        if (_atual is null || _gravando) return;

        _gravando = true;
        try
        {
            // GUARDA O ESTADO ANTERIOR ANTES DE GRAVAR. Depois de gravar, ele não existe em lugar nenhum
            // — a marca no .md foi por cima. `Agendamento` nulo é a informação de que o cartão era
            // inédito, e desfazer precisa dela para APAGAR a marca em vez de escrever outra.
            var desfazivel = new Desfazivel(_atual.Nota, _atual.Linha, _atual.Agendamento, _atual.Frente);

            var r = await Cartoes.ResponderAsync(_atual.Nota, _atual.Linha, resposta);
            if (!r.Ok)
            {
                // Conflito aqui é a nota tendo mudado por fora no meio da revisão. Recarregar a fila é a
                // resposta certa: o cartão pode ter mudado de linha, ou nem existir mais.
                Avisos.Add(r.Mensagem ?? "Não consegui gravar a revisão.", Severity.Warning);
                await CarregarAsync();
                return;
            }

            _desfazivel = desfazivel;
            _revisados++;

            // "Errei" devolve o cartão para a fila de hoje, e ele tem de voltar a aparecer NESTA sessão —
            // é o ponto de errar. Por isso a fila é recarregada em vez de só avançar o índice.
            if (resposta == Resposta.Errei)
            {
                _fila = (await Cartoes.FilaAsync(_materia)).Cartoes;
                // ...mas não imediatamente: reencontrar o mesmo cartão no clique seguinte é decorar a
                // resposta de dois segundos atrás, não lembrar. Ele vai para o fim da fila.
                _fila = [.. _fila.Where(c => !(c.Nota.Equals(_atual.Nota) && c.Linha == _atual.Linha)),
                         .. _fila.Where(c => c.Nota.Equals(_atual.Nota) && c.Linha == _atual.Linha)];
            }
            else
            {
                _fila = _fila.Skip(1).ToList();
            }

            Avancar();
        }
        finally
        {
            _gravando = false;
        }
    }
}
