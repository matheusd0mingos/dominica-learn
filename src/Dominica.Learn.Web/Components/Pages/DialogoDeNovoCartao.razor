@using Dominica.Learn.Application.CasosDeUso
@using Dominica.Learn.Domain.Cartoes
@using Dominica.Learn.Domain.Vault

@inject ServicoDeCartoes Cartoes
@inject ServicoDeConhecimento Conhecimento
@inject ISnackbar Avisos

@* Criar um cartão SEM DECORAR A SINTAXE.

   O recurso de flashcard já existia inteiro — analisador, agendamento SM-2, fila de revisão. O que não
   existia era o gesto de criar: era preciso lembrar se são dois ou três dois-pontos, se o de várias
   linhas usa "?" ou "??", e onde cada um entra. Uma sintaxe que precisa ser decorada é uma sintaxe que
   não se usa, e o resultado era um recurso que existia no código e não na vida de ninguém.

   O DIÁLOGO NÃO GUARDA NADA. Ele monta o texto e o insere no cursor — o cartão passa a morar na nota,
   em Markdown que o Obsidian lê. Guardá-lo numa tabela seria mais fácil e quebraria a promessa: o vault
   continuaria abrindo no Obsidian, só que sem os cartões. *@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Cartão novo</MudText>
    </TitleContent>
    <DialogContent>
        @* ONDE O CARTÃO VAI MORAR — só quando quem chamou não tem nota aberta (o caso da tela de
           revisar). Vindo da tela de notas, o destino é óbvio: a nota que está na frente. Perguntar ali
           seria um clique a mais para responder o que já se sabe.

           O padrão é a nota do cartão que está na tela. Quem está revisando e pensa "falta um cartão
           sobre isto" quase sempre quer que ele viva junto do que explica o assunto. *@
        @if (EscolherDestino)
        {
            <MudSelect T="string" @bind-Value="_destino" Label="Em qual nota" Variant="Variant.Outlined"
                       Dense="true" Class="mb-3">
                @foreach (var n in _notas)
                {
                    <MudSelectItem T="string" Value="@n.Valor">@n.Nome <span class="mud-text-secondary">@n.Pasta</span></MudSelectItem>
                }
            </MudSelect>
        }

        <MudTextField @bind-Value="_frente" @bind-Value:after="Recalcular" Label="Pergunta" Variant="Variant.Outlined"
                      AutoFocus="true" Immediate="true" Lines="2"
                      Placeholder="Prazo para impugnar o edital" />

        <MudTextField @bind-Value="_verso" @bind-Value:after="Recalcular" Label="Resposta" Variant="Variant.Outlined" Class="mt-3"
                      Immediate="true" Lines="3"
                      Placeholder="Até 3 dias úteis antes da abertura" />

        @if (!string.IsNullOrWhiteSpace(Selecao))
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                A resposta veio do trecho que você selecionou. Falta a pergunta — e formulá-la é a parte
                que ensina.
            </MudText>
        }

        @* Mão dupla não é padrão de propósito: ele dobra a carga de revisão, e a maioria dos pares de
           estudo só faz sentido num sentido ("Prazo → 3 dias" sim; "3 dias → Prazo" não diz nada). *@
        <MudCheckBox @bind-Value="_duplo" @bind-Value:after="Recalcular" Color="Color.Primary" Class="mt-2"
                     Label="Perguntar também ao contrário (dobra a revisão)" />

        @if (_problema is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@Explicar(_problema.Value)</MudAlert>
        }

        @* A PRÉVIA É O QUE ENSINA A SINTAXE sem exigir que ela seja decorada: depois de ver "Prazo::3
           dias" algumas vezes, a pessoa passa a escrever direto no editor — e aí o diálogo virou
           desnecessário, que é o melhor que ele pode fazer. *@
        @if (_previa is not null)
        {
            <MudText Typo="Typo.overline" Class="mt-3 d-block">Vai ficar assim na nota</MudText>
            <pre class="cartao-previa">@_previa</pre>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(_previa is null || _gravando || (EscolherDestino && _destino.Length == 0))"
                   OnClick="Confirmar">@(EscolherDestino ? "Criar cartão" : "Inserir na nota")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialogo { get; set; } = default!;

    /// <summary>
    /// O trecho selecionado no editor, quando o cartão nasce de uma frase já escrita.
    ///
    /// ENTRA COMO RESPOSTA, e não como pergunta: lendo um resumo, o que se marca é o FATO que se quer
    /// lembrar — "até 3 dias úteis antes da abertura". A pergunta é o que ainda não existe, e formulá-la
    /// é justamente onde o estudo acontece. Trocar os dois faria a ferramenta escrever a parte que ensina
    /// e pedir a parte que não ensina.
    /// </summary>
    [Parameter] public string? Selecao { get; set; }

    /// <summary>
    /// Ligado por quem NÃO tem nota aberta — hoje, a tela de revisar. Com ele o diálogo mostra o seletor
    /// de nota e GRAVA sozinho; sem ele, devolve o texto para quem chamou inserir no cursor.
    ///
    /// As duas metades são o mesmo gesto com destinos diferentes, e é por isso que moram no mesmo
    /// diálogo: a parte que ensina — escrever pergunta e resposta, ver a prévia, ser barrado quando o
    /// "::" está na pergunta — não pode existir em duas versões que divergem no primeiro ajuste.
    /// </summary>
    [Parameter] public bool EscolherDestino { get; set; }

    /// <summary>A nota que já vem escolhida. Ver o comentário do seletor.</summary>
    [Parameter] public CaminhoNota? DestinoSugerido { get; set; }

    private string _frente = string.Empty;
    private string _verso = string.Empty;
    private bool _duplo;

    private string? _previa;
    private ProblemaDoCartao? _problema;

    private IReadOnlyList<CaminhoNota> _notas = [];
    private string _destino = string.Empty;
    private bool _gravando;

    /// <summary>
    /// Chamada por @bind-Value:after em cada campo, e não por OnParametersSet: aquele só dispara quando
    /// um PARÂMETRO muda, e o que muda aqui é estado interno. Com ele, a prévia ficaria congelada no que
    /// existia quando o diálogo abriu — vazia, para sempre.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        _verso = (Selecao ?? string.Empty).Trim();
        Recalcular();

        if (!EscolherDestino) return;

        _notas = await Conhecimento.TodosOsCaminhosAsync();
        _destino = DestinoSugerido?.Valor ?? _notas.FirstOrDefault()?.Valor ?? string.Empty;
    }

    private void Recalcular()
    {
        // O problema só é MOSTRADO depois que a pessoa escreveu algo dos dois lados: acusar "pergunta
        // vazia" no diálogo recém-aberto é reclamar de algo que ninguém teve chance de fazer ainda.
        var comecou = _frente.Trim().Length > 0 && _verso.Trim().Length > 0;

        if (RedatorDeCartao.TentarEscrever(_frente, _verso, _duplo, out var texto, out var problema))
        {
            _previa = texto?.TrimEnd('\n');
            _problema = null;
        }
        else
        {
            _previa = null;
            _problema = comecou ? problema : null;
        }
    }

    private async Task Confirmar()
    {
        Recalcular();
        if (_gravando || !RedatorDeCartao.TentarEscrever(_frente, _verso, _duplo, out var texto, out _)) return;

        // Sem destino a escolher, o diálogo continua sendo só um escritor de texto: quem chamou insere.
        if (!EscolherDestino) { Dialogo.Close(DialogResult.Ok(texto!)); return; }

        if (!CaminhoNota.TentarCriar(_destino, out var caminho, out _) || caminho is null) return;

        _gravando = true;
        try
        {
            var r = await Cartoes.AcrescentarCartaoAsync(caminho, texto!);
            if (!r.Ok) { Avisos.Add(r.Mensagem ?? "Não consegui gravar o cartão.", Severity.Error); return; }

            Dialogo.Close(DialogResult.Ok(r.Valor!));
        }
        finally
        {
            _gravando = false;
        }
    }

    private void Cancelar() => Dialogo.Cancel();

    private static string Explicar(ProblemaDoCartao p) => p switch
    {
        ProblemaDoCartao.FrenteVazia => "Falta a pergunta.",
        ProblemaDoCartao.VersoVazio => "Falta a resposta.",
        _ => "A pergunta não pode conter \"::\" — é o separador que divide pergunta e resposta.",
    };
}
