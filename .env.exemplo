# Copie para .env (que NÃO é versionado) e preencha.

# Credenciais do Postgres. Gere a senha com: openssl rand -base64 32
POSTGRES_USER=learn
POSTGRES_PASSWORD=

# A PASTA DO SEU VAULT no host. É a mesma que você abre no Obsidian Desktop — é isso que faz os dois
# editarem o mesmo conhecimento. Precisa pertencer ao uid 64198 (o usuário do contêiner):
#   sudo chown -R 64198:64198 /caminho/do/vault
VAULT_NO_HOST=/srv/dominica-learn/vault
